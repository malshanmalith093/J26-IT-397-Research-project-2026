MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/research_db
JWT_SECRET=change-me

# =====================================================================
# Component 2 advice engine - AI provider
# Fill in ONE of the blocks below. With none, the app uses offline
# rule-based advice. Optional: LLM_PROVIDER=openai | azure_foundry |
# azure_openai | custom  (otherwise it is detected automatically).
# =====================================================================

# --- Option 1: Azure AI Foundry (Microsoft Foundry) --------------------
# Works for Azure OpenAI models (gpt-4.1-mini, gpt-4o, ...) AND Foundry
# models such as DeepSeek, Llama, Mistral, Grok, MAI-DS-R1.
# Endpoint: copy from the Foundry portal (resource overview). Any of these work:
#   https://<resource>.services.ai.azure.com
#   https://<resource>.openai.azure.com
#   https://<resource>.cognitiveservices.azure.com
# AZURE_FOUNDRY_ENDPOINT=https://<resource>.services.ai.azure.com
# AZURE_FOUNDRY_API_KEY=<key 1 from the portal>
# AZURE_FOUNDRY_MODEL=<your deployment name, e.g. gpt-4.1-mini>
# Keyless login instead of a key (needs: pip install azure-identity, then az login):
# AZURE_FOUNDRY_AUTH=entra

# --- Option 2: OpenAI ---------------------------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4.1-mini

# --- Option 3: Custom OpenAI-compatible endpoint ------------------------
# LM Studio  http://localhost:1234/v1      Ollama  http://localhost:11434/v1
# vLLM / LiteLLM / OpenRouter (https://openrouter.ai/api/v1) / company gateway
# CUSTOM_OPENAI_BASE_URL=http://localhost:11434/v1
# CUSTOM_OPENAI_API_KEY=            # leave empty for local servers
# CUSTOM_OPENAI_MODEL=llama3.1
# CUSTOM_OPENAI_HEADERS={"X-Title": "EduPulse"}   # optional extra headers (JSON)

# --- Option 4: Classic Azure OpenAI (api-version style) -----------------
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_DEPLOYMENT=<deployment-name>
# AZURE_OPENAI_API_VERSION=2024-10-21

# --- Component 1 -> Component 2 link -----------------------------------
# Shared secret that the Component 1 model / simulator scripts send in the
# X-C1-API-Key header. If empty, Component 2 only accepts them from this computer.
# C1_API_KEY=choose-a-long-random-string
# C2_URL=http://localhost:3000     # where the simulator scripts send outputs

# --- Advanced (optional) ------------------------------------------------
# ADVICE_MODE=fallback        # always use offline rule-based advice
# LLM_JSON_MODE=json_schema   # force json_schema | json_object | prompt (default: auto)
# OPENAI_TIMEOUT=60
# OPENAI_MAX_TOKENS=4000           # starting output budget; doubled automatically if the reply is cut off
